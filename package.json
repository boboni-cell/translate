{
  "name": "translate",
  "version": "0.1.0",
  "description": "Mac 现场韩语转写与中文实时翻译",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "preview": "vite --host 127.0.0.1",
    "package:mac": "npm run build && electron-builder --mac zip --publish never",
    "test:package": "node tests/package-smoke.mjs"
  },
  "keywords": [],
  "author": "boboni-cell",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "type": "module",
  "build": {
    "appId": "com.boboni.translate",
    "productName": "听译",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "听译需要麦克风来实时识别韩语并翻译为中文。"
      }
    }
  }
}
